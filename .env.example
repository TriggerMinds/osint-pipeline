# OSINT Pipeline Configuration
# Copy to .env and fill in your keys

OSINT_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
OSINT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OSINT_DEEPSEEK_MODEL=deepseek-reasoner

# SearXNG — comma-separated list of instances
OSINT_SEARXNG_INSTANCES=http://localhost:8888,https://search.sapti.me

# Connector endpoints (defaults are fine for most use cases)
OSINT_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
OSINT_COMMONCRAWL_BASE_URL=https://index.commoncrawl.org
OSINT_ARCHIVE_CDX_URL=https://web.archive.org/cdx/search/cdx
OSINT_ARCHIVE_WAYBACK_URL=https://web.archive.org/web

# Pipeline tuning
OSINT_MAX_CONCURRENT_FETCHES=10
OSINT_REQUEST_TIMEOUT=30
OSINT_MAX_QUERIES_PER_EXPANSION=15
OSINT_EVIDENCE_MIN_CONFIDENCE=0.3
