# OSINT Pipeline Configuration
# Copy to .env — do NOT commit .env

# ── LLM ───────────────────────────────────────────────────────────────
OSINT_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ── Connectors ─────────────────────────────────────────────────────────
OSINT_SEARXNG_INSTANCES=http://localhost:8888,https://search.sapti.me
OSINT_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
OSINT_COMMONCRAWL_BASE_URL=https://index.commoncrawl.org
OSINT_ARCHIVE_CDX_URL=https://web.archive.org/cdx/search/cdx
OSINT_ARCHIVE_WAYBACK_URL=https://web.archive.org/web

# ── Additional connectors ──────────────────────────────────────────────
OSINT_GITHUB_TOKEN=
OSINT_OPENALEX_EMAIL=
OSINT_REDDIT_CLIENT_ID=
OSINT_REDDIT_CLIENT_SECRET=
OSINT_LIBRETRANSLATE_URL=

# Wikidata SPARQL endpoint (default is fine)
# OSINT_WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql

# ── Network transport ──────────────────────────────────────────────────
# Hysteria2 / proxy — set only the local listener endpoint
# Do NOT put VPS IP, hysteria config, or credentials here
OSINT_PROXY_URL=socks5://127.0.0.1:1080

# ── Browser runtime ────────────────────────────────────────────────────
OSINT_BROWSER_ENGINE=playwright
# Only needed if engine=cloakbrowser — point to the CloakBrowser binary
# OSINT_CLOAKBROWSER_EXECUTABLE=/path/to/cloakbrowser
OSINT_BROWSER_HEADLESS=true
OSINT_BROWSER_USER_DATA_DIR=

# ── Crawl runtime ──────────────────────────────────────────────────────
OSINT_CRAWL_WAIT_FOR_JS=true
OSINT_CRAWL_OUTPUT_FORMAT=markdown

# ── Retry / timeout ────────────────────────────────────────────────────
OSINT_REQUEST_TIMEOUT=30
OSINT_REQUEST_RETRIES=3
OSINT_REQUEST_BACKOFF_FACTOR=1.5
OSINT_REQUEST_MAX_BACKOFF=60.0
OSINT_RETRY_STATUS_CODES=429,500,502,503,504
